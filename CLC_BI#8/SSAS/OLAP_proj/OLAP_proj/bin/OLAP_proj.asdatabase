      <MdxScripts>
        <MdxScript>
          <ID>MdxScript</ID>
          <Name>MdxScript</Name>
          <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
          <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
          <Commands>
            <Command>
              <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 

-- =====================================================
-- EXISTING MEASURES (Đã có sẵn)
-- =====================================================

CREATE MEMBER CURRENTCUBE.[Measures].[On Time Count]
 AS SUM(
    EXISTING [Fact Flights].[Flight ID].[Flight ID].MEMBERS,
    IIF([Measures].[Fact Flights Count] &gt; 0 AND [Measures].[Sum Arr Delay] &lt;= 5 AND [Measures].[Sum Arr Delay] &gt;= -5, 1, 0)
), 
VISIBLE = 1,
DISPLAY_FOLDER = 'Performance Metrics\On-Time Performance'; 

CREATE MEMBER CURRENTCUBE.[Measures].[OTP %]
 AS IIF(
    [Measures].[Fact Flights Count] &gt; 0,
    [Measures].[On Time Count] / [Measures].[Fact Flights Count],
    NULL
), 
FORMAT_STRING = "Percent", 
VISIBLE = 1,
DISPLAY_FOLDER = 'Performance Metrics\On-Time Performance'; 

CREATE MEMBER CURRENTCUBE.[Measures].[Cancellation Rate]
AS 
IIF(
    [Measures].[Fact Flights Count] &gt; 0,
    [Measures].[Sum Cancelled] / [Measures].[Fact Flights Count],
    NULL
),
VISIBLE = 1, 
FORMAT_STRING = "Percent",
DISPLAY_FOLDER = 'Performance Metrics\Cancellation'; 

CREATE MEMBER CURRENTCUBE.[Measures].[Avg Dep Delay]
AS 
IIF(
    [Measures].[Fact Flights Count] &gt; 0,
    [Measures].[Sum Dep Delay] / [Measures].[Fact Flights Count],
    NULL
),
VISIBLE = 1, 
FORMAT_STRING = "#,##0.00",
DISPLAY_FOLDER = 'Performance Metrics\Delays'; 


-- =====================================================
-- DELAY &amp; ARRIVAL METRICS
-- =====================================================

-- Measure: Avg Arr Delay (Thời gian trễ đến trung bình)
-- Dashboard 01: So sánh OTP và delay theo hãng
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Arr Delay]
AS 
    IIF([Measures].[Fact Flights Count] = 0, NULL,
        [Measures].[Sum Arr Delay] / [Measures].[Fact Flights Count]),
FORMAT_STRING = "#,##0.00",
VISIBLE = 1,
DISPLAY_FOLDER = 'Performance Metrics\Delays'; 

-- Measure: Delayed Flights Count (Số chuyến bị delay - Arr Delay &gt; 0)
CREATE MEMBER CURRENTCUBE.[Measures].[Delayed Flights Count] 
AS 
    COUNT(
        FILTER(
            [Fact Flights].[Flight ID].[Flight ID].Members, 
            [Measures].[Sum Arr Delay] &gt; 0
        )
    ),
VISIBLE = 1,
DISPLAY_FOLDER = 'Performance Metrics\Delays'; 

-- Measure: Total Delay Rate (Tỷ lệ delay tổng quát)
CREATE MEMBER CURRENTCUBE.[Measures].[Total Delay Rate] 
AS 
    IIF([Measures].[Fact Flights Count] = 0, NULL, 
        [Measures].[Delayed Flights Count] / [Measures].[Fact Flights Count]),
FORMAT_STRING = "Percent",
VISIBLE = 1,
DISPLAY_FOLDER = 'Performance Metrics\Delays'; 

-- Measure: Delay Over 15m Count (Số chuyến trễ &gt; 15 phút)
CREATE MEMBER CURRENTCUBE.[Measures].[Delay Over 15m Count] 
AS 
    SUM(
        FILTER(
            [Fact Flights].[Flight ID].[Flight ID].Members, 
            [Measures].[Sum Arr Delay] &gt; 15
        ),
        [Measures].[Fact Flights Count]
    ),
VISIBLE = 1,
DISPLAY_FOLDER = 'Performance Metrics\Delays'; 

-- Measure: Delay Rate &gt; 15m (Tỷ lệ trễ &gt; 15 phút)
CREATE MEMBER CURRENTCUBE.[Measures].[Delay Rate &gt; 15m] 
AS 
    IIF([Measures].[Fact Flights Count] = 0, NULL, 
        [Measures].[Delay Over 15m Count] / [Measures].[Fact Flights Count]),
FORMAT_STRING = "Percent",
VISIBLE = 1,
DISPLAY_FOLDER = 'Performance Metrics\Delays'; 


-- =====================================================
-- ON-TIME PERFORMANCE (ALTERNATIVE DEFINITIONS)
-- =====================================================

-- Measure: OTP Count (Số chuyến đúng giờ - định nghĩa strict: delay &lt;= 0)
CREATE MEMBER CURRENTCUBE.[Measures].[OTP Count] 
AS 
    SUM(
        FILTER(
            [Fact Flights].[Flight ID].[Flight ID].Members, 
            [Measures].[Sum Arr Delay] &lt;= 0
        ),
        [Measures].[Fact Flights Count]
    ),
VISIBLE = 1,
DISPLAY_FOLDER = 'Performance Metrics\On-Time Performance'; 

-- Measure: OTP Percentage (Tỷ lệ đúng giờ - dựa trên OTP Count)
CREATE MEMBER CURRENTCUBE.[Measures].[OTP Percentage] 
AS 
    IIF([Measures].[Fact Flights Count] = 0, NULL, 
        [Measures].[OTP Count] / [Measures].[Fact Flights Count]),
FORMAT_STRING = "Percent",
VISIBLE = 1,
DISPLAY_FOLDER = 'Performance Metrics\On-Time Performance'; 


-- =====================================================
-- AIRPORT TRAFFIC METRICS
-- =====================================================

-- Measure: Arriving Flights (Số chuyến đến)
-- Dashboard 02: Phân tích sân bay
-- Context-sensitive: tính số chuyến đến của sân bay hiện tại
CREATE MEMBER CURRENTCUBE.[Measures].[Arriving Flights] 
AS
    ([Dest Airport].[Airport Name].CurrentMember, [Measures].[Fact Flights Count]),
VISIBLE = 1,
DISPLAY_FOLDER = 'Airport Metrics\Traffic'; 


-- =====================================================
-- GROUND OPERATIONS METRICS
-- =====================================================

-- Measure: Avg Taxi In (Thời gian taxi in trung bình)
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Taxi In] 
AS
    IIF([Measures].[Fact Flights Count] = 0, NULL,
        [Measures].[Taxi In] / [Measures].[Fact Flights Count]),
FORMAT_STRING = "#,##0.00",
VISIBLE = 1,
DISPLAY_FOLDER = 'Airport Metrics\Ground Operations'; 

-- Measure: Avg Taxi Out (Thời gian taxi out trung bình)
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Taxi Out] 
AS
    IIF([Measures].[Fact Flights Count] = 0, NULL,
        [Measures].[Taxi Out] / [Measures].[Fact Flights Count]),
FORMAT_STRING = "#,##0.00",
VISIBLE = 1,
DISPLAY_FOLDER = 'Airport Metrics\Ground Operations'; 

-- Measure: Avg Total Taxi (Tổng thời gian taxi trung bình)
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Total Taxi] 
AS
    IIF([Measures].[Fact Flights Count] = 0, NULL,
        ([Measures].[Taxi In] + [Measures].[Taxi Out]) / [Measures].[Fact Flights Count]),
FORMAT_STRING = "#,##0.00",
VISIBLE = 1,
DISPLAY_FOLDER = 'Airport Metrics\Ground Operations'; 


-- =====================================================
-- AIRPORT PERFORMANCE METRICS
-- =====================================================

-- Measure: Airport Delay Rate (Tỷ lệ delay theo sân bay)
CREATE MEMBER CURRENTCUBE.[Measures].[Airport Delay Rate] 
AS
    IIF([Measures].[Fact Flights Count] = 0, 0,
        COUNT(FILTER(EXISTING [Fact Flights].[Flight ID].MEMBERS, [Measures].[Arr Delay] &gt; 0)) 
        / [Measures].[Fact Flights Count]),
FORMAT_STRING = "Percent",
VISIBLE = 1,
DISPLAY_FOLDER = 'Airport Metrics\Performance'; 

-- Measure: Airport Cancel Rate (Tỷ lệ hủy theo sân bay)
CREATE MEMBER CURRENTCUBE.[Measures].[Airport Cancel Rate] 
AS
    IIF([Measures].[Fact Flights Count] = 0, 0,
        ([Measures].[Fact Flights Count], [Fact Flights].[Is Cancelled].&amp;[1]) 
        / [Measures].[Fact Flights Count]),
FORMAT_STRING = "Percent",
VISIBLE = 1,
DISPLAY_FOLDER = 'Airport Metrics\Performance'; 


-- =====================================================
-- DASHBOARD 04: RISK &amp; INCIDENT METRICS
-- =====================================================

-- Measure: Diverted Count (Số chuyến bay bị chuyển hướng)
CREATE MEMBER CURRENTCUBE.[Measures].[Diverted Count] 
AS 
    (
        [Fact Flights].[Is Diverted].&amp;[1],
        [Measures].[Fact Flights Count]
    ),
VISIBLE = 1,
DISPLAY_FOLDER = 'Risk Metrics\Diversions'; 

-- Measure: Diverted Rate (Tỷ lệ chuyến bay bị chuyển hướng)
CREATE MEMBER CURRENTCUBE.[Measures].[Diverted Rate] 
AS 
    IIF([Measures].[Fact Flights Count] = 0, NULL, 
        [Measures].[Diverted Count] / [Measures].[Fact Flights Count]),
FORMAT_STRING = "Percent",
VISIBLE = 1,
DISPLAY_FOLDER = 'Risk Metrics\Diversions'; 

-- Measure: Serious Delay Count (Số chuyến delay nghiêm trọng &gt; 120 phút)
CREATE MEMBER CURRENTCUBE.[Measures].[Serious Delay Count] 
AS 
    SUM(
        FILTER(
            [Fact Flights].[Flight ID].[Flight ID].Members, 
            [Measures].[Sum Arr Delay] &gt; 120
        ),
        [Measures].[Fact Flights Count]
    ),
VISIBLE = 1,
DISPLAY_FOLDER = 'Risk Metrics\Serious Delays'; 

CREATE MEMBER CURRENTCUBE.[Measures].[Serious Delay Rate] 
AS 
    IIF(
        [Measures].[Fact Flights Count] = 0, 
        NULL, 
        [Measures].[Serious Delay Count] / [Measures].[Fact Flights Count]
    ), 
    FORMAT_STRING = "Percent",
    VISIBLE = 1,
    DISPLAY_FOLDER = 'Risk Metrics\Delays'; 


-- =====================================================
-- CALENDAR HIERARCHY DISPLAY MEMBERS
-- =====================================================

CREATE MEMBER CURRENTCUBE.[Measures].[Year]
AS 
    [Dim Date].[Calendar].CurrentMember.Parent.Parent.Parent.Name,
VISIBLE = 1,
DISPLAY_FOLDER = 'Calendar Display'; 

CREATE MEMBER CURRENTCUBE.[Measures].[Quarter]
AS 
    [Dim Date].[Calendar].CurrentMember.Parent.Parent.Name,
VISIBLE = 1,
DISPLAY_FOLDER = 'Calendar Display'; 

CREATE MEMBER CURRENTCUBE.[Measures].[Month Name]
AS 
    [Dim Date].[Calendar].CurrentMember.Parent.Name,
VISIBLE = 1,
DISPLAY_FOLDER = 'Calendar Display'; 

CREATE MEMBER CURRENTCUBE.[Measures].[Month Number]
AS 
    [Dim Date].[Calendar].CurrentMember.Name,
VISIBLE = 1,
DISPLAY_FOLDER = 'Calendar Display'; 

-- For Quarter Level (mới thêm)
CREATE MEMBER CURRENTCUBE.[Measures].[Year For Quarter]
AS 
    IIF(
        [Dim Date].[Calendar].CurrentMember.Level.Ordinal &gt;= 1,
        ANCESTOR([Dim Date].[Calendar].CurrentMember, [Dim Date].[Calendar].[Year]).Name,
        NULL
    ),
VISIBLE = 1,
DISPLAY_FOLDER = 'Calendar Display'; 

CREATE MEMBER CURRENTCUBE.[Measures].[Quarter Display]
AS 
    IIF(
        [Dim Date].[Calendar].CurrentMember.Level.Ordinal &gt;= 2,
        [Dim Date].[Calendar].CurrentMember.Name,
        NULL
    ),
VISIBLE = 1,
DISPLAY_FOLDER = 'Calendar Display'; 

-- =====================================================
-- DELAY BREAKDOWN METRICS (Average by Delayed Flights)
-- =====================================================

-- Measure: Avg Carrier Delay (Thời gian delay do hãng bay trung bình trên các chuyến bị delay)
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Carrier Delay]
AS 
    IIF([Measures].[Delayed Flights Count] = 0, NULL,
        [Measures].[Carrier Delay Minutes] / [Measures].[Delayed Flights Count]),
FORMAT_STRING = "#,##0.00",
VISIBLE = 1,
DISPLAY_FOLDER = 'Performance Metrics\Delay Breakdown'; 

-- Measure: Avg Weather Delay (Thời gian delay do thời tiết trung bình trên các chuyến bị delay)
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Weather Delay]
AS 
    IIF([Measures].[Delayed Flights Count] = 0, NULL,
        [Measures].[Weather Delay Minutes] / [Measures].[Delayed Flights Count]),
FORMAT_STRING = "#,##0.00",
VISIBLE = 1,
DISPLAY_FOLDER = 'Performance Metrics\Delay Breakdown'; 

-- Measure: Avg NAS Delay (Thời gian delay do hệ thống hàng không trung bình trên các chuyến bị delay)
CREATE MEMBER CURRENTCUBE.[Measures].[Avg NAS Delay]
AS 
    IIF([Measures].[Delayed Flights Count] = 0, NULL,
        [Measures].[NAS Delay Minutes] / [Measures].[Delayed Flights Count]),
FORMAT_STRING = "#,##0.00",
VISIBLE = 1,
DISPLAY_FOLDER = 'Performance Metrics\Delay Breakdown'; 

-- Measure: Avg Late Aircraft Delay (Thời gian delay do máy bay đến muộn trung bình trên các chuyến bị delay)
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Late Aircraft Delay]
 AS IIF([Measures].[Delayed Flights Count] = 0, NULL,
        [Measures].[Late Aircraft Delay Minutes] / [Measures].[Delayed Flights Count]), 
FORMAT_STRING = "#,##0.00", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Performance Metrics\Delay Breakdown'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Security Delay]
 AS IIF([Measures].[Delayed Flights Count] = 0, NULL,
        [Measures].[Security Delay Minutes] / [Measures].[Delayed Flights Count]), 
FORMAT_STRING = "Standard", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Total Delay Min]
 AS [Measures].[Carrier Delay Minutes] + [Measures].[Weather Delay Minutes] + 
[Measures].[NAS Delay Minutes] + [Measures].[Security Delay Minutes] + 
[Measures].[Late Aircraft Delay Minutes], 
FORMAT_STRING = "Standard", 
VISIBLE = 1  ; </Text>
            </Command>
          </Commands>
        </MdxScript>
      </MdxScripts>
    </Cube>
  </Cubes>

  <MdxScripts>
    <MdxScript dwd:design-time-name="6bea26f3-b606-452a-be50-162834fb2c12">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CREATE MEMBER CURRENTCUBE.[Measures].[On Time Count]
 AS SUM(
    [Fact_Flights],
    IIF([Measures].[Sum Arr Delay] &lt;= 5 AND [Measures].[Sum Arr Delay] &gt;= -5, 1, 0)
), 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[OTP %]
 AS IIF(
    [Measures].[Flight Count] = 0,
    NULL,
    [Measures].[On Time Count] / [Measures].[Flight Count]
), 
FORMAT_STRING = "Percent", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Cancellation Rate]
 AS IIF(
    [Measures].[Flight Count] = 0,
    NULL,
    [Measures].[Sum Cancelled] / [Measures].[Flight Count]
), 
FORMAT_STRING = "Percent", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Dep Delay]
 AS IIF(
    [Measures].[Flight Count] = 0,
    NULL,
    [Measures].[Sum Dep Delay] / [Measures].[Flight Count]
), 
FORMAT_STRING = "#,##0.00%;-#,##0.00%", 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>
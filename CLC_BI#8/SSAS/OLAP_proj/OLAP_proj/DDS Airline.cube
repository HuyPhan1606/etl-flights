  <MdxScripts>
    <MdxScript dwd:design-time-name="63b9aec5-41f5-403b-bd59-a1e6b92f9f18">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;   

CREATE MEMBER CURRENTCUBE.[Measures].[On Time Count]
 AS SUM(
    EXISTING [Fact Flights].[Flight ID].[Flight ID].MEMBERS,
    IIF([Measures].[Fact Flights Count] &gt; 0 AND [Measures].[Sum Arr Delay] &lt;= 5 AND [Measures].[Sum Arr Delay] &gt;= -5, 1, 0)
), 
VISIBLE = 1; 

CREATE MEMBER CURRENTCUBE.[Measures].[OTP %]
AS 
IIF(
    [Measures].[Fact Flights Count] &gt; 0,
    [Measures].[On Time Count] / [Measures].[Fact Flights Count] * 100,
    NULL
),
VISIBLE = 1, 
FORMAT_STRING = "Percent";  

CREATE MEMBER CURRENTCUBE.[Measures].[Cancellation Rate]
AS 
IIF(
    [Measures].[Fact Flights Count] &gt; 0,
    [Measures].[Sum Cancelled] / [Measures].[Fact Flights Count],
    NULL
),
VISIBLE = 1, 
FORMAT_STRING = "Percent";  

CREATE MEMBER CURRENTCUBE.[Measures].[Avg Dep Delay]
AS 
IIF(
    [Measures].[Fact Flights Count] &gt; 0,
    [Measures].[Sum Dep Delay] / [Measures].[Fact Flights Count],
    NULL
),
VISIBLE = 1, 
FORMAT_STRING = "#,##0.00"; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>